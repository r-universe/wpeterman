[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "corMLPE"]
	path = corMLPE
	url = https://github.com/wpeterman/cormlpe
[submodule "landgraph"]
	path = landgraph
	url = https://github.com/wpeterman/landgraph
[submodule "multiScaleR"]
	path = multiScaleR
	url = https://github.com/wpeterman/multiscaler
